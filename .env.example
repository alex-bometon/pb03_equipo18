# ReciclaTIA PB03 — Configuracion de referencia

# Gemini
GEMINI_API_KEY=

# PostgreSQL
DATABASE_URL=

# Aprovisionamiento administrativo obligatorio
ADMIN_EMAIL=
ADMIN_PASSWORD=
API_KEY=

# Servidor HTTP
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Autenticacion y autorizacion
SESSION_TTL_SECONDS=28800
BCRYPT_ROUNDS=12

FREE_MAX_ACTIVE_KEYS=1
USER_MAX_ACTIVE_KEYS=5

# Conexiones PostgreSQL
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_SECONDS=3

# UUID autorizados separados por comas
USER_TIER_ALLOWED_USER_IDS=

# Rate limiting HTTP
RATE_LIMIT_PER_MINUTE=30

# Cuotas comerciales Free
FREE_RATE_LIMIT_PER_MINUTE=2
FREE_RATE_LIMIT_PER_HOUR=10
FREE_RATE_LIMIT_PER_DAY=30

# Cuotas comerciales User
USER_RATE_LIMIT_PER_MINUTE=5
USER_RATE_LIMIT_PER_HOUR=20
USER_RATE_LIMIT_PER_DAY=45

# Limites de seguridad
LOGIN_EMAIL_LIMIT_PER_15_MINUTES=5
LOGIN_ORIGIN_LIMIT_PER_15_MINUTES=20
REGISTER_LIMIT_PER_HOUR=5

KEY_ISSUE_LIMIT_PER_HOUR=3
KEY_ISSUE_LIMIT_PER_DAY=5

# Ejecucion del asistente
AGENT_MAX_WORKERS=1
ASK_TIMEOUT_SECONDS=60

# Limites absolutos de imagenes
IMAGE_UPLOAD_MAX_BYTES=20971520
IMAGE_UPLOAD_MAX_PIXELS=32000000

# Cliente Streamlit
API_BASE_URL=http://localhost:8000

# Trazabilidad opcional
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=reciclatia-pb03